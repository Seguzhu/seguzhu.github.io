---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-14 mt-8">
    <div class="text-xl py-2">欢迎光临 👋</div>
    <div class="text-5xl font-bold py-2">我是彭行也</div>
    <div class="text-3xl py-4 font-bold leading-snug">电吉他学习中 · 日语学习中 · 一般路过百合豚 · 写点东西</div>
    <div class="py-4">
      <text class="text-lg leading-loose max-w-2xl inline-block">
        这里是我的个人小站。我是一个多元兴趣者，你能在这里看到各种各样的<b>学习分享</b>、<b>听读体会</b>以及一些 <b>AI 制作的小工具</b>。
        目前以电吉他和日语学习为主，欢迎您随便逛逛，感兴趣可以联系我 🍋
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="/blog/">看看我的博客</a>
      <a href="/projects/" target="_self" class="btn btn-outline ml-5">
        我做的东西
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">我的项目 {"</>"}</div>
  </div>

  <HorizontalCard
    title="🌀 3D 游戏防晕眩工具"
    img="/post_img.webp"
    desc="给晕 3D 的玩家做的缓解工具：玩 3D 游戏时减轻眩晕感。AI 辅助开发的实验性项目，持续迭代中。"
    url="#"
    badge="制作中"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="🌱 占位卡片"
    img="/post_img.webp"
    desc="这是一张占位卡片，之后可以换成你的新项目、新作品或任何想展示的东西。"
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="🌱 占位卡片"
    img="/post_img.webp"
    desc="另一张占位卡片。不需要就删掉，需要更多就复制一份改文字。"
    url="#"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">最近的文章</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
