---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [], headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article">
  <style is:inline>
    html { scroll-behavior: smooth; }
    h2[id], h3[id] { scroll-margin-top: 1.5rem; }
  </style>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      {
        toc.length > 0 && (
          <details class="collapse collapse-arrow bg-base-200 mb-6 rounded-box lg:hidden">
            <summary class="collapse-title text-base font-bold py-2 min-h-0">📑 目录</summary>
            <div class="collapse-content">
              <ul class="menu w-full gap-0.5 text-sm p-0">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "ml-4" : ""}>
                    <a href={`#${h.slug}`} class="py-1 min-h-0">{h.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )
      }
      <slot />
    </article>
    {
      toc.length > 0 && (
        <aside class="hidden lg:block self-start sticky top-8 ml-10 w-60 shrink-0">
          <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4">
              <div class="text-sm font-bold opacity-70">📑 目录</div>
              <ul class="menu w-full gap-0.5 text-sm p-0">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "ml-4" : ""}>
                    <a href={`#${h.slug}`} class="py-1 min-h-0">{h.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      )
    }
  </main>
</BaseLayout>
